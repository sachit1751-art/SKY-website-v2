{
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/index.ts" },
    { "source": "/feed.xml", "destination": "/api/index.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api/|sitemap\\.xml|feed\\.xml).*)", "destination": "/index.html" }
  ]
}
